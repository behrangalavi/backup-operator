{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "backup-operator values",
  "type": "object",
  "additionalProperties": true,
  "required": ["image", "agePublicKeys"],
  "$defs": {
    "quantity": { "type": ["string", "integer"], "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|T|P|E|Ki|Mi|Gi|Ti|Pi|Ei)?$" },
    "resourceList": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu": { "$ref": "#/$defs/quantity" },
        "memory": { "$ref": "#/$defs/quantity" },
        "ephemeral-storage": { "$ref": "#/$defs/quantity" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": { "oneOf": [{ "$ref": "#/$defs/resourceList" }, { "type": "null" }] },
        "requests": { "oneOf": [{ "$ref": "#/$defs/resourceList" }, { "type": "null" }] }
      }
    },
    "labels": { "type": "object", "additionalProperties": { "type": "string" } },
    "ageKey": { "type": "string", "pattern": "^age1[a-z0-9]+$" },
    "cron": { "type": "string", "minLength": 9 },
    "objectList": { "type": "array", "items": { "type": "object" } },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initialDelaySeconds": { "type": "integer", "minimum": 0 },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "successThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "egressRules": { "type": "array", "items": { "type": "object", "required": ["ports"] } }
  },
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" } } } },
    "replicaCount": { "type": "integer", "minimum": 0 },
    "strategy": { "type": "object" },
    "nodeSelector": { "$ref": "#/$defs/labels" },
    "tolerations": { "$ref": "#/$defs/objectList" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "$ref": "#/$defs/objectList" },
    "priorityClassName": { "type": "string" },
    "podAnnotations": { "$ref": "#/$defs/labels" },
    "podLabels": { "$ref": "#/$defs/labels" },
    "extraEnv": { "$ref": "#/$defs/objectList" },
    "envFrom": { "$ref": "#/$defs/objectList" },
    "extraVolumes": { "$ref": "#/$defs/objectList" },
    "extraVolumeMounts": { "$ref": "#/$defs/objectList" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": { "$ref": "#/$defs/probe" },
        "liveness": { "$ref": "#/$defs/probe" },
        "readiness": { "$ref": "#/$defs/probe" }
      }
    },
    "watchNamespace": { "type": "string" },
    "crds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": { "type": "boolean" },
        "keep": { "type": "boolean" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultSchedule": { "$ref": "#/$defs/cron" },
        "runTimeoutSeconds": { "type": "integer", "minimum": 1 },
        "tempDir": { "type": "string", "pattern": "^/" },
        "leaderElectionId": { "type": "string" },
        "defaultRetentionDays": { "type": "integer", "minimum": 0 },
        "defaultMinKeep": { "type": "integer", "minimum": 0 },
        "metricsRefreshIntervalSeconds": { "type": ["integer", "null"], "minimum": 5 }
      }
    },
    "agePublicKeys": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ageKey" } }
      ]
    },
    "resources": { "$ref": "#/$defs/resources" },
    "workerResources": { "$ref": "#/$defs/resources" },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeSelector": { "$ref": "#/$defs/labels" },
        "tolerations": { "$ref": "#/$defs/objectList" },
        "affinity": { "type": "object" },
        "priorityClassName": { "type": "string" },
        "podAnnotations": { "$ref": "#/$defs/labels" },
        "extraEnv": { "$ref": "#/$defs/objectList" },
        "extraVolumes": { "$ref": "#/$defs/objectList" },
        "extraVolumeMounts": { "$ref": "#/$defs/objectList" }
      }
    },
    "workerBackoffLimit": { "type": "integer", "minimum": 0, "maximum": 10 },
    "tempDirSize": { "$ref": "#/$defs/quantity" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "create": { "type": "boolean" } }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "storageScrub": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "intervalHours": { "type": "integer", "minimum": 1 }
      }
    },
    "restoreVerification": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enableEphemeralPodSpawn": { "type": "boolean" } }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "readOnly": { "type": "boolean" },
        "allowKeyMutation": { "type": "boolean" },
        "maxBodyBytes": { "type": "integer", "minimum": 1024 },
        "maxSSEClients": { "type": "integer", "minimum": 1 }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "dir": { "type": "string" }
      }
    },
    "pprof": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "alerts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prometheusURL": { "type": "string" },
        "alertmanagerURL": { "type": "string" }
      }
    },
    "prometheusReleaseLabel": { "type": "string" },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
        "scrapeTimeout": { "type": "string", "pattern": "^[0-9]+(ms|s|m|h)$" },
        "labels": { "$ref": "#/$defs/labels" },
        "relabelings": { "$ref": "#/$defs/objectList" },
        "metricRelabelings": { "$ref": "#/$defs/objectList" }
      }
    },
    "prometheusRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "labels": { "$ref": "#/$defs/labels" },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["alert", "expr"],
            "properties": {
              "alert": { "type": "string" },
              "expr": { "type": "string" },
              "for": { "type": "string" },
              "labels": { "$ref": "#/$defs/labels" },
              "annotations": { "$ref": "#/$defs/labels" }
            }
          }
        }
      }
    },
    "grafanaDashboard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "type": "string" },
        "labels": { "$ref": "#/$defs/labels" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "apiServerCIDRs": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-fA-F.:]+/[0-9]+$" } },
        "monitoringNamespace": { "type": "string" },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "allowedFrom": { "$ref": "#/$defs/objectList" } }
        },
        "ui": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "allowedFrom": { "$ref": "#/$defs/objectList" } }
        },
        "extraIngressRules": { "$ref": "#/$defs/objectList" },
        "extraEgressRules": { "$ref": "#/$defs/egressRules" },
        "worker": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "databasePorts": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 65535 } },
            "extraEgressRules": { "$ref": "#/$defs/egressRules" }
          }
        }
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" }
  }
}
